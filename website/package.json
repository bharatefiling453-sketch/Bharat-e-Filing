{
  "name": "bharat-efiling-website",
  "version": "1.0.0",
  "private": true,
  "description": "Bharat eFiling product-page design system, GST Registration reference page and QA toolchain",
  "type": "module",
  "scripts": {
    "serve": "npx --no-install http-server . -p 8080 -c-1",
    "format": "prettier --write \"**/*.{html,css,js,mjs,md,json}\"",
    "lint:html": "html-validate \"gst-registration/*.html\"",
    "lint:css": "stylelint \"assets/css/*.css\"",
    "lint:links": "linkinator gst-registration/index.html --skip \"^https?://\"",
    "check:seo": "node scripts/seo-check.mjs gst-registration/index.html",
    "check:a11y": "node scripts/a11y-check.mjs gst-registration/index.html",
    "check": "npm run lint:html && npm run lint:css && npm run check:seo && npm run check:a11y",
    "lighthouse": "lighthouse http://localhost:8080/gst-registration/ --chrome-flags=\"--headless\" --output html --output-path ./reports/lighthouse.html",
    "build:single": "node scripts/build-single-file.mjs gst-registration"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "cheerio": "^1.2.0",
    "html-validate": "^11.16.1",
    "http-server": "^14.1.1",
    "lighthouse": "^13.5.0",
    "linkinator": "^8.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "schema-dts": "^2.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
